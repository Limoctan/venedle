# Copy to .env before running docker compose.
# Compose reads this file automatically for variable interpolation.

# Password for the venedle Postgres user (required).
POSTGRES_PASSWORD=change-me

# Host port where Postgres is exposed in DEV (container stays 5432 internal).
# Defaults to 5434 so it does not clash with a local Postgres on 5433/5432.
POSTGRES_HOST_PORT=5434

# Host port for the backend API in DEV (container stays 3000 internal).
# Defaults to 3000; bump it if your non-Docker backend is also running.
# BACKEND_HOST_PORT=3000

# Host port for nginx in PROD (default 80).
# FRONTEND_PORT=8080
